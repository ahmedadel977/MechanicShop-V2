# انسخ هذا الملف باسم .env، واملأ القيم السرية يدويًا. لا ترفع .env إلى Git.
# لا يُقبل أي ترخيص تلقائيًا؛ راجع الشروط ثم اكتب Y صراحةً.
MSSQL_ACCEPT_EULA=Y
SEQ_ACCEPT_EULA=Y

# كلمة مرور قوية (18 حرفًا: أحرف كبيرة وصغيرة وأرقام ورموز آمنة لـ .env)
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_LOCAL_SQL_PASSWORD
MSSQL_PID=Developer

# JWT secret: 48 حرف ASCII (48 بايت UTF-8)
JWT_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_UTF8_BYTES

SEQ_ADMIN_USER=admin
SEQ_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_SEQ_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_GRAFANA_PASSWORD

# منافذ المضيف؛ يمكن تغييرها عند تعارضها مع برامج أخرى.
API_HTTP_PORT=5106
MSSQL_HOST_PORT=1433
REDIS_HOST_PORT=6379
SEQ_HOST_PORT=5341
SEQ_INGEST_HOST_PORT=5342
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
