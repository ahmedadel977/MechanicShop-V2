{
  "ConnectionStrings": {
    "DefaultConnection": "Server = . ; Database = MechanicShopDb ; Trusted_Connection=True; MultipleActiveResultSets = true ; TrustServerCertificate = True;",
    "Redis": "localhost:6379"

  },
  "AppSettings": {
    "OpeningTime": "00:00",
    "ClosingTime": "23:59:59",
    "MaxSpots": 4,
    "MinimumAppointmentDurationInMinutes": 30,
    "LocalCacheExpirationInMins": 5,
    "DistributedCacheExpirationMins": 5,
    "DefaultPageNumber": 1,
    "DefaultPageSize": 10,
    "BookingCancellationThresholdMinutes": 15,
    "OverdueBookingCleanupFrequencyMinutes": 3,
    "CorsPolicyName": "MechanicShop",
    "AllowedOrigins": [ "https://localhost:5001", "http://mechanicshop-app" ]
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "GlobalWindowMinutes": 1,
    "GlobalConcurrencyLimit": 50,
    "LoginPermitLimit": 5,
    "LoginWindowMinutes": 1,
    "RefreshPermitLimit": 10,
    "RefreshWindowMinutes": 1,
    "AuthenticatedUserPermitLimit": 120,
    "AuthenticatedUserWindowMinutes": 1,
    "AccountCreationPermitLimit": 5,
    "AccountCreationWindowMinutes": 1
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://ops.seq:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "api"
    }
  },
  "JwtSettings": {
    "TokenExpirationInMinutes": 60,
    "Issuer": "localhost",
    "Audience": "localhost"
  },

  "EmailSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "MechanicShop"
  },


  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
